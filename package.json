{
  "name": "roadmap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:nix": "nix-shell --run 'npx prisma generate' && next build",
    "start": "next start",
    "lint": "eslint",
    "db:init": "bash scripts/init-db.sh",
    "db:generate": "nix-shell --run 'npx prisma generate'",
    "db:migrate": "nix-shell --run 'npx prisma migrate dev'",
    "db:push": "./init-db.sh",
    "db:studio": "nix-shell --run 'npx prisma studio'",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose up --build -d",
    "docker:logs": "docker compose logs -f app"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@notionhq/client": "^5.23.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hot-toast": "^2.6.0",
    "react-xarrows": "^2.0.2",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^10",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^6"
  },
  "description": "A high-performance, read-optimized roadmap dashboard that syncs with Notion and displays project timelines in a custom CSS Grid-based Gantt view.",
  "main": "index.js",
  "directories": {
    "lib": "lib"
  },
